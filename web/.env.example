# Optional. Leave unset in dev: requests go to /api/* and the Vite proxy
# (see vite.config.ts) forwards them to http://127.0.0.1:8000.
#
# Set this to talk to a node directly (e.g. for a production build served from
# somewhere other than the node). No trailing slash. The node sends
# Access-Control-Allow-Origin: *, so a cross-origin base URL works too.
# VITE_API_BASE=http://127.0.0.1:8000
